  { id:8, nom:'Elastiques Class III 1/4', cat:'elastiques', qte:350, seuil:200, prix:0.05 },
  { id:9, nom:'Cire orthodontique (boites)', cat:'cire', qte:80, seuil:30, prix:1.2 },
  { id:10, nom:'Bagues molaires 1ere molaire', cat:'bagues', qte:40, seuil:20, prix:6.5 },
  { id:11, nom:'Fil de contention tresse 0.0195', cat:'contention', qte:12, seuil:10, prix:18 },
  { id:12, nom:'Composite de collage Transbond XT', cat:'consommables', qte:8, seuil:5, prix:42 },
  { id:13, nom:'Ligatures elastomeriques', cat:'consommables', qte:1000, seuil:400, prix:0.02 },
];

const DEMO_COMMANDES = [
  { id:'ORT-2026-042', fournisseur:'Invisalign', date:'2026-04-20', montant:1350, statut:'livree', designation:'Aligneurs lot patient Durand' },
  { id:'ORT-2026-041', fournisseur:'Ormco', date:'2026-04-15', montant:680, statut:'en_cours', designation:'Fils NiTi + brackets ceramiques' },
  { id:'ORT-2026-038', fournisseur:'3M Unitek', date:'2026-04-02', montant:420, statut:'livree', designation:'Brackets Clarity Advanced + Transbond' },
  { id:'ORT-2026-035', fournisseur:'American Orthodontics', date:'2026-03-22', montant:250, statut:'livree', designation:'Elastiques assortis + bagues molaires' },
];

// ═══════════════════════════════════
// RENDER: PATIENTS
// ═══════════════════════════════════
let patientsData = [...DEMO_PATIENTS];

function renderPatients() {
  const tbody = document.getElementById('patients-body');
  const search = (document.getElementById('search-patients')?.value || '').toLowerCase();
  const typeFilter = document.getElementById('filter-type')?.value || '';
  const statutFilter = document.getElementById('filter-statut')?.value || '';

  let filtered = patientsData.filter(p => {
    if (search && !(p.nom + ' ' + p.prenom).toLowerCase().includes(search)) return false;
    if (typeFilter && p.type !== typeFilter) return false;
    if (statutFilter && p.statut !== statutFilter) return false;
    return true;
  });

  document.getElementById('patients-count').textContent = filtered.length + ' patient' + (filtered.length > 1 ? 's' : '');

  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--muted);">Aucun patient trouve</td></tr>';
    return;
  }

  tbody.innerHTML = filtered.map(p => {
    const age = calcAge(p.ddn);
    const typeBadge = typeLabel(p.type);
    const statutBadge = statutLabel(p.statut);
    const barColor = p.progression >= 80 ? 'var(--green)' : p.progression >= 40 ? 'var(--accent)' : 'var(--amber)';
    const prochaine = p.prochaine ? formatDate(p.prochaine) : '<span style="color:var(--muted);">—</span>';
    return `<tr>
      <td><div style="font-weight:500;">${esc(p.nom)} ${esc(p.prenom)}</div><div style="font-size:11px;color:var(--muted);">${esc(p.email)}</div></td>
      <td>${age} ans</td>
      <td>${typeBadge}</td>
      <td>
        <div class="progress-wrap">
          <div class="progress-bar"><div class="progress-fill" style="width:${p.progression}%;background:${barColor};"></div></div>
          <span class="progress-pct">${p.progression}%</span>
        </div>
      </td>
      <td>${prochaine}</td>
      <td>${statutBadge}</td>
      <td>
        <div class="action-btns">
          <button class="icon-btn cmd" title="Voir le dossier" aria-label="Voir le dossier" onclick="showToast('Dossier patient -- a venir')">&#x1F4C4;</button>
          <button class="icon-btn" title="Photos avant/apres" aria-label="Photos avant apres" onclick="showToast('Galerie photos -- a venir')">&#x1F4F7;</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

function filterPatients() { renderPatients(); }

// ═══════════════════════════════════
// RENDER: TRAITEMENTS
// ═══════════════════════════════════
function renderTraitements() {
  const container = document.getElementById('traitements-list');
  const search = (document.getElementById('search-traitements')?.value || '').toLowerCase();
  const typeFilter = document.getElementById('filter-trt-type')?.value || '';

  let filtered = patientsData.filter(p => {
    if (p.statut === 'termine') return false;
    if (search && !(p.nom + ' ' + p.prenom).toLowerCase().includes(search)) return false;
    if (typeFilter && p.type !== typeFilter) return false;
    return true;
  });

  if (filtered.length === 0) {
    container.innerHTML = '<div class="empty"><div class="empty-icon">&#x1F9B7;</div><div class="empty-title">Aucun traitement en cours</div><div class="empty-sub">Vos traitements actifs apparaitront ici.</div></div>';
    return;
  }

  container.innerHTML = filtered.map(p => {
    const age = calcAge(p.ddn);
    const barColor = p.progression >= 80 ? 'var(--green)' : p.progression >= 40 ? 'var(--accent)' : 'var(--amber)';
    const prochaine = p.prochaine ? formatDate(p.prochaine) : 'Non planifie';
    const dureeEstimee = p.type === 'contention' ? '6 mois' : p.type === 'interceptif' ? '8-12 mois' : '18-24 mois';
    return `<div class="card" style="margin-bottom:14px;">
      <div class="card-body">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
          <div>
            <div style="font-weight:600;font-size:15px;">${esc(p.nom)} ${esc(p.prenom)} <span style="font-size:12px;color:var(--muted);font-weight:400;">${age} ans</span></div>
            <div style="font-size:12px;color:var(--muted);margin-top:4px;">${esc(p.notes)}</div>
          </div>
          <div style="text-align:right;">
            ${typeLabel(p.type)}
            <div style="font-size:11px;color:var(--muted);margin-top:4px;">Duree estimee : ${dureeEstimee}</div>
          </div>
        </div>
        <div style="margin-top:16px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
            <span style="font-size:12px;font-weight:500;">Progression</span>
            <span style="font-size:12px;font-family:var(--mono);color:var(--muted);">${p.progression}%</span>
          </div>
          <div class="progress-bar" style="height:8px;">
            <div class="progress-fill" style="width:${p.progression}%;background:${barColor};height:100%;"></div>
          </div>
        </div>
        <div style="display:flex;gap:20px;margin-top:14px;flex-wrap:wrap;">
          <div style="font-size:12px;"><span style="color:var(--muted);">Prochaine seance :</span> <strong>${prochaine}</strong></div>
          <div style="font-size:12px;"><span style="color:var(--muted);">Paye :</span> <strong>${fmtEur(p.paye)} / ${fmtEur(p.montant)}</strong></div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function filterTraitements() { renderTraitements(); }

// ═══════════════════════════════════
// RENDER: PLANNING
// ═══════════════════════════════════
let planningRendered = false;
let planningWeekOffset = 0;

function renderPlanning() {
  planningRendered = true;
  const container = document.getElementById('planning-grid');
  const today = new Date();
  const start = new Date(today);
  start.setDate(start.getDate() - start.getDay() + 1 + planningWeekOffset * 7);

  const jours = ['Lundi','Mardi','Mercredi','Jeudi','Vendredi'];
  const creneaux = ['08:30','09:00','09:30','10:00','10:30','11:00','11:30','14:00','14:30','15:00','15:30','16:00','16:30','17:00','17:30'];

  // Generate some demo appointments
  const rdvs = [
    { jour:0, heure:'09:00', duree:45, patient:'Durand Lucas', type:'aligneurs', note:'Controle gouttiere 8' },
    { jour:0, heure:'10:00', duree:30, patient:'Garcia Raphael', type:'bagues', note:'Collage brackets' },
    { jour:0, heure:'14:00', duree:60, patient:'Martin Emma', type:'bagues', note:'Changement fil + elastiques' },
    { jour:1, heure:'09:30', duree:30, patient:'Petit Leo', type:'interceptif', note:'Controle disjoncteur' },
    { jour:1, heure:'11:00', duree:45, patient:'Bernard Chloe', type:'aligneurs', note:'Remise gouttiere 4' },
    { jour:2, heure:'09:00', duree:30, patient:'Moreau Jade', type:'contention', note:'Verification fil colle' },
    { jour:2, heure:'14:30', duree:60, patient:'Nouveau patient', type:'', note:'Premiere consultation' },
    { jour:3, heure:'10:00', duree:45, patient:'Durand Lucas', type:'aligneurs', note:'Photos + scan' },
    { jour:4, heure:'09:00', duree:30, patient:'Garcia Raphael', type:'bagues', note:'Controle' },
    { jour:4, heure:'15:00', duree:60, patient:'Bernard Chloe', type:'aligneurs', note:'Consultation progression' },
  ];

  let html = '<table style="min-width:700px;">';
  html += '<thead><tr><th style="width:80px;">Heure</th>';
  for (let j = 0; j < 5; j++) {
    const d = new Date(start);
    d.setDate(d.getDate() + j);
    const isToday = d.toDateString() === today.toDateString();
    html += `<th style="${isToday ? 'color:var(--accent);' : ''}">${jours[j]} ${d.getDate()}/${d.getMonth()+1}</th>`;
  }
  html += '</tr></thead><tbody>';

  creneaux.forEach(h => {
    html += `<tr><td style="font-family:var(--mono);font-size:11px;color:var(--muted);padding:8px 12px;">${h}</td>`;
    for (let j = 0; j < 5; j++) {
      const rdv = rdvs.find(r => r.jour === j && r.heure === h);
      if (rdv) {
        const color = rdv.duree === 60 ? 'var(--accent)' : rdv.duree === 45 ? 'var(--purple)' : 'var(--green)';
        html += `<td style="padding:4px;">
          <div style="background:${color}15;border-left:3px solid ${color};border-radius:6px;padding:8px 10px;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform=''">
            <div style="font-size:12px;font-weight:600;">${esc(rdv.patient)}</div>
            <div style="font-size:10px;color:var(--muted);margin-top:2px;">${rdv.duree} min — ${esc(rdv.note)}</div>
          </div>
        </td>`;
      } else {
        html += '<td style="padding:4px;"></td>';
      }
    }
    html += '</tr>';
  });
  html += '</tbody></table>';
  container.innerHTML = html;
}

function planningPrev() { planningWeekOffset--; renderPlanning(); }
function planningNext() { planningWeekOffset++; renderPlanning(); }
function planningToday() { planningWeekOffset = 0; renderPlanning(); }

// ═══════════════════════════════════
// RENDER: PAIEMENTS ECHELONNES
// ═══════════════════════════════════
function renderPaiements() {
  const container = document.getElementById('echeanciers-list');
  const actifs = patientsData.filter(p => p.montant > 0 && p.statut !== 'termine');

  let totalDu = 0, totalEncaisse = 0, nbRetard = 0;
  actifs.forEach(p => {
    totalDu += p.montant;
    totalEncaisse += p.paye;
    if (p.paye < p.montant * (p.progression / 100) * 0.8) nbRetard++;
  });

  document.getElementById('ech-total').textContent = fmtEur(totalDu);
  document.getElementById('ech-encaisse').textContent = fmtEur(totalEncaisse);
  document.getElementById('ech-retard').textContent = nbRetard + ' patient' + (nbRetard > 1 ? 's' : '');

  const badge = document.getElementById('retard-badge');
  if (badge && nbRetard > 0) { badge.textContent = nbRetard; badge.style.display = 'inline-block'; }

  container.innerHTML = actifs.map(p => {
    const pct = Math.round((p.paye / p.montant) * 100);
    const reste = p.montant - p.paye;
    const barColor = pct >= 80 ? 'var(--green)' : pct >= 40 ? 'var(--accent)' : 'var(--amber)';
    const isLate = p.paye < p.montant * (p.progression / 100) * 0.8;
    return `<div class="ech-card${isLate ? ' ' : ''}" style="${isLate ? 'border-color:rgba(239,68,68,0.4);' : ''}">
      <div class="ech-header">
        <div>
          <div class="ech-patient">${esc(p.nom)} ${esc(p.prenom)}</div>
          <div class="ech-detail">${typeLabel(p.type)} — ${esc(p.notes)}</div>
        </div>
        <div style="text-align:right;">
          <div class="ech-amount">${fmtEur(p.montant)}</div>
          ${isLate ? '<span class="badge badge-crit" style="margin-top:4px;">Retard</span>' : ''}
        </div>
      </div>
      <div style="margin-bottom:8px;">
        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;">
          <span style="color:var(--muted);">Paye : ${fmtEur(p.paye)}</span>
          <span style="color:var(--muted);">Reste : ${fmtEur(reste)}</span>
        </div>
        <div class="progress-bar" style="height:8px;">
          <div class="progress-fill" style="width:${pct}%;background:${barColor};height:100%;"></div>
        </div>
        <div style="text-align:right;font-size:11px;color:var(--muted);margin-top:4px;">${pct}% regle</div>
      </div>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════
// RENDER: STOCK
// ═══════════════════════════════════
let stockData = [...DEMO_STOCK];

function renderStock() {
  const tbody = document.getElementById('stock-body');
  const search = (document.getElementById('search-stock')?.value || '').toLowerCase();
  const catFilter = document.getElementById('filter-stock-cat')?.value || '';

  let filtered = stockData.filter(s => {
    if (search && !s.nom.toLowerCase().includes(search)) return false;
    if (catFilter && s.cat !== catFilter) return false;
    return true;
  });

  document.getElementById('stock-count').textContent = filtered.length + ' produit' + (filtered.length > 1 ? 's' : '');

  // KPI
  let total = stockData.length, crit = 0, warn = 0, valeur = 0;
  stockData.forEach(s => {
    if (s.qte <= s.seuil * 0.5) crit++;
    else if (s.qte <= s.seuil) warn++;
    valeur += s.qte * s.prix;
  });
  document.getElementById('stock-total').textContent = total;
  document.getElementById('stock-crit').textContent = crit;
  document.getElementById('stock-warn').textContent = warn;
  document.getElementById('stock-valeur').textContent = fmtEur(valeur);

  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--muted);">Aucun produit trouve</td></tr>';
    return;
  }

  tbody.innerHTML = filtered.map(s => {
    const ratio = s.qte / s.seuil;
    let badge, barColor;
    if (ratio <= 0.5) { badge = '<span class="badge badge-crit">Critique</span>'; barColor = 'var(--red)'; }
    else if (ratio <= 1) { badge = '<span class="badge badge-warn">Faible</span>'; barColor = 'var(--amber)'; }
    else { badge = '<span class="badge badge-ok">OK</span>'; barColor = 'var(--green)'; }
    const barPct = Math.min(100, Math.round((s.qte / (s.seuil * 2)) * 100));
    const catLabel = stockCatLabel(s.cat);
    return `<tr>
      <td><div style="font-weight:500;">${esc(s.nom)}</div></td>
      <td><span class="badge badge-blue">${catLabel}</span></td>
      <td>
        <div class="bar-wrap">
          <div class="bar"><div class="bar-fill" style="width:${barPct}%;background:${barColor};"></div></div>
          <span class="qty-num">${s.qte}</span>
        </div>
      </td>
      <td style="font-size:12px;font-family:var(--mono);color:var(--muted);">${s.seuil}</td>
      <td>${badge}</td>
      <td>
        <div class="action-btns">
          <button class="icon-btn cmd" title="Commander" aria-label="Commander" onclick="showToast('Commande rapide -- a venir')">&#x1F6D2;</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

function filterStock() { renderStock(); }

// ═══════════════════════════════════
// RENDER: COMMANDES
// ═══════════════════════════════════
function renderCommandes() {
  const tbody = document.getElementById('commandes-body');
  document.getElementById('cmd-count').textContent = DEMO_COMMANDES.length + ' commande' + (DEMO_COMMANDES.length > 1 ? 's' : '');

  tbody.innerHTML = DEMO_COMMANDES.map(c => {
    let badge;
    if (c.statut === 'livree') badge = '<span class="badge badge-ok">Livree</span>';
    else if (c.statut === 'en_cours') badge = '<span class="badge badge-warn">En cours</span>';
    else badge = '<span class="badge badge-blue">En attente</span>';
    return `<tr>
      <td style="font-family:var(--mono);font-size:12px;">${esc(c.id)}</td>
      <td style="font-weight:500;">${esc(c.fournisseur)}</td>
      <td>${formatDate(c.date)}</td>
      <td style="font-family:var(--mono);">${fmtEur(c.montant)}</td>
      <td>${badge}</td>
      <td><button class="icon-btn" title="Voir" aria-label="Voir la commande" onclick="showToast('Detail commande -- a venir')">&#x1F4C4;</button></td>
    </tr>`;
  }).join('');
}

// ═══════════════════════════════════
// RENDER: COMPTABILITE
// ═══════════════════════════════════
function renderCompta() {
  const recettes = 12400;
  const depenses = 3200;
  const net = recettes - depenses;
  const marge = Math.round((net / recettes) * 100);

  document.getElementById('compta-recettes').textContent = fmtEur(recettes);
  document.getElementById('compta-depenses').textContent = fmtEur(depenses);
  document.getElementById('compta-net').textContent = fmtEur(net);
  document.getElementById('compta-marge').textContent = marge + '%';

  const recDetail = [
    { label: 'Traitements aligneurs', montant: 5200 },
    { label: 'Traitements bagues', montant: 4800 },
    { label: 'Contention', montant: 1200 },
    { label: 'Consultations', montant: 800 },
    { label: 'Interceptif', montant: 400 },
  ];
  document.getElementById('compta-recettes-detail').innerHTML = recDetail.map(r =>
    `<div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);font-size:13px;">
      <span>${r.label}</span><span style="font-family:var(--mono);font-weight:500;">${fmtEur(r.montant)}</span>
    </div>`
  ).join('');

  const depDetail = [
    { label: 'Materiel orthodontique', montant: 1800 },
    { label: 'Aligneurs / Gouttieres', montant: 680 },
    { label: 'Consommables', montant: 320 },
    { label: 'Charges fixes', montant: 400 },
  ];
  document.getElementById('compta-depenses-detail').innerHTML = depDetail.map(r =>
    `<div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);font-size:13px;">
      <span>${r.label}</span><span style="font-family:var(--mono);font-weight:500;color:var(--red);">${fmtEur(r.montant)}</span>
    </div>`
  ).join('');
}

// ═══════════════════════════════════
// KPI UPDATE
// ═══════════════════════════════════
function updateKPIs() {
  const actifs = patientsData.filter(p => p.statut === 'actif');
  const enCours = patientsData.filter(p => p.statut !== 'termine');
  const retards = patientsData.filter(p => p.paye < p.montant * (p.progression / 100) * 0.8 && p.statut !== 'termine');
  const caMois = 12400;

  document.getElementById('kpi-patients').textContent = actifs.length;
  document.getElementById('kpi-traitements').textContent = enCours.length;
  document.getElementById('kpi-ca').textContent = fmtEur(caMois);
  document.getElementById('kpi-retard').textContent = retards.length;
}

// ═══════════════════════════════════
// FORM ACTIONS (DEMO)
// ═══════════════════════════════════
function ajouterPatient() {
  const nom = document.getElementById('pat-nom').value.trim();
  const prenom = document.getElementById('pat-prenom').value.trim();
  if (!nom || !prenom) { showToast('Veuillez renseigner le nom et le prenom'); return; }

  patientsData.push({
    id: Date.now(),
    nom, prenom,
    ddn: document.getElementById('pat-ddn').value || '2010-01-01',
    tel: document.getElementById('pat-tel').value,
    email: document.getElementById('pat-email').value,
    type: document.getElementById('pat-type').value,
    statut: 'actif',
    progression: 0,
    prochaine: null,
    notes: document.getElementById('pat-notes').value,
    montant: 0,
    paye: 0
  });

  fermerModal('modal-patient');
  renderPatients();
  updateKPIs();
  showToast('Patient ajoute avec succes');
  // Reset form
  ['pat-nom','pat-prenom','pat-ddn','pat-tel','pat-email','pat-notes'].forEach(id => document.getElementById(id).value = '');
}

function creerEcheancier() {
  showToast('Echeancier cree (demo)');
  fermerModal('modal-echeancier');
}

function creerCommande() {
  showToast('Commande enregistree (demo)');
  fermerModal('modal-commande');
}

// ═══════════════════════════════════
// HELPERS
// ═══════════════════════════════════
function esc(s) {
  if (!s) return '';
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}

function fmtEur(n) {
  if (n == null || isNaN(n)) return '--';
  return parseFloat(n).toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' EUR';
}

function formatDate(str) {
  if (!str) return '--';
  const d = new Date(str);
  return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
}

function calcAge(ddn) {
  if (!ddn) return '--';
  const born = new Date(ddn);
  const now = new Date();
  let age = now.getFullYear() - born.getFullYear();
  if (now.getMonth() < born.getMonth() || (now.getMonth() === born.getMonth() && now.getDate() < born.getDate())) age--;
  return age;
}

function typeLabel(type) {
  const map = {
    aligneurs: { label: 'Aligneurs', cls: 'badge-blue' },
    bagues: { label: 'Bagues', cls: 'badge-purple' },
    contention: { label: 'Contention', cls: 'badge-ok' },
    interceptif: { label: 'Interceptif', cls: 'badge-warn' },
  };
  const m = map[type] || { label: type || '--', cls: 'badge-ok' };
  return `<span class="badge ${m.cls}">${m.label}</span>`;
}

function statutLabel(statut) {
  const map = {
    actif: { label: 'Actif', cls: 'badge-ok' },
    termine: { label: 'Termine', cls: 'badge-blue' },
    pause: { label: 'En pause', cls: 'badge-warn' },
  };
  const m = map[statut] || { label: statut, cls: 'badge-ok' };
  return `<span class="badge ${m.cls}">${m.label}</span>`;
}

function stockCatLabel(cat) {
  const map = {
    aligneurs: 'Aligneurs', brackets: 'Brackets', fils: 'Fils', elastiques: 'Elastiques',
    cire: 'Cire', bagues: 'Bagues', contention: 'Contention', consommables: 'Consommables'
  };
  return map[cat] || cat;
}

// ═══════════════════════════════════
// INIT
// ═══════════════════════════════════
document.addEventListener('DOMContentLoaded', async function() {
  const session = await checkAuth();
  // Render all with demo data (fallback if no API)
  updateKPIs();
  renderPatients();
  renderTraitements();
  renderPaiements();
  renderStock();
  renderCommandes();
  renderCompta();
});
</script>
</body>
</html>
