*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --dark:#FAF7F2;--surface:#F5F0E8;--surface2:#EDE7DB;
  --gold:#8B6914;--gold-l:#A67C1A;--gold-d:#6B5010;
  --teal:#0D7D6C;--teal-d:#0A6457;
  --blue:#2D5CB8;
  --txt:#1A1A2E;--txt2:#4A4A5C;--txt3:#8A8A98;
  --glow-gold:rgba(139,105,20,.15);
  --glow-teal:rgba(13,125,108,.12);
  --cream-1:#FAF7F2;--cream-2:#F5F0E8;--cream-3:#EDE7DB;
}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{font-family:'Inter',system-ui,sans-serif;background:#F0EBE0;color:#1A1A2E;margin:0}
img{max-width:100%;display:block}

/* ═══ A4 ═══ */
.a4{width:210mm;min-height:297mm;margin:0 auto;position:relative;overflow:hidden;background:linear-gradient(170deg,#FAF7F2 0%,#F5F0E8 40%,#EDE7DB 100%);color:var(--txt);page-break-after:always;page-break-inside:avoid}
@media screen{.a4{margin:20px auto;box-shadow:0 8px 40px rgba(139,105,20,.12),0 2px 8px rgba(0,0,0,.06);border-radius:4px}}
@media print{body{background:#fff}.a4{margin:0;box-shadow:none;width:100%;min-height:100vh}.no-print{display:none!important}}

/* ═══ EFFECTS ═══ */
.glow-gold{filter:drop-shadow(0 4px 16px rgba(139,105,20,.15))}
.glow-teal{filter:drop-shadow(0 4px 16px rgba(13,125,108,.12))}
.glow-box-gold{box-shadow:0 4px 24px rgba(139,105,20,.08),inset 0 1px 0 rgba(139,105,20,.06)}
.glow-box-teal{box-shadow:0 4px 24px rgba(13,125,108,.06),inset 0 1px 0 rgba(13,125,108,.05)}
.shimmer{position:relative;overflow:hidden}
.shimmer::after{content:'';position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgba(0,0,0,.04),transparent);animation:shimmer 4s ease-in-out infinite}
@keyframes shimmer{0%{left:-100%}100%{left:200%}}

/* ═══ LIGHT RAYS ═══ */
.rays{position:absolute;width:100%;height:100%;top:0;left:0;pointer-events:none;overflow:hidden}
.ray{position:absolute;width:2px;background:linear-gradient(to bottom,rgba(139,105,20,.15),transparent);transform-origin:top center}

/* ═══ TAGS ═══ */
.tag{display:inline-block;padding:4px 12px;border-radius:20px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
.tag-gold{background:linear-gradient(135deg,var(--gold),var(--gold-d));color:#fff}
.tag-teal{background:linear-gradient(135deg,var(--teal),var(--teal-d));color:#fff}
.tag-outline{border:1px solid rgba(139,105,20,.25);color:var(--gold);background:rgba(139,105,20,.05)}
.tag-glass{background:rgba(255,255,255,.7);border:1px solid rgba(0,0,0,.08);color:var(--txt);backdrop-filter:blur(8px)}

/* ═══ TABLES ═══ */
.tbl{width:100%;border-collapse:separate;border-spacing:0;font-size:10px;border-radius:10px;overflow:hidden}
.tbl th,.tbl td{padding:8px 10px;text-align:center;border-bottom:1px solid rgba(0,0,0,.06)}
.tbl th{background:linear-gradient(135deg,rgba(139,105,20,.1),rgba(139,105,20,.04));color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.04em;font-size:9px}
.tbl td:first-child{text-align:left;font-weight:600;color:var(--txt)}
.tbl td{color:var(--txt2)}
.tbl tr:last-child td{border-bottom:none}

/* ═══ FEAT CARDS ═══ */
.feat{padding:12px;background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:10px;position:relative;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.04)}
.feat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--gold),transparent)}
.feat h4{font-size:10px;font-weight:700;color:var(--gold);margin-bottom:3px}
.feat p{font-size:9px;color:var(--txt2);line-height:1.5}

/* ═══ PRICE BOX ═══ */
.price-box{padding:16px 20px;border-radius:12px;text-align:center;position:relative;overflow:hidden}
.price-box::before{content:'';position:absolute;inset:0;border-radius:12px;padding:1px;background:linear-gradient(135deg,rgba(139,105,20,.2),transparent,rgba(13,125,108,.15));-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude}
.price-box-gold{background:linear-gradient(135deg,rgba(139,105,20,.06),rgba(139,105,20,.02))}
.price-box-teal{background:linear-gradient(135deg,rgba(13,125,108,.05),rgba(13,125,108,.02))}
.price-row2{display:flex;justify-content:space-between;padding:5px 0;font-size:12px;border-bottom:1px solid rgba(0,0,0,.04)}
.price-row2:last-child{border-bottom:none}
.price-row2 .label{color:var(--txt2)}
.price-row2 .val{font-weight:700}
.price-row2 .val.teal{color:var(--teal)}
.price-row2 .val.gold{color:var(--gold)}

/* ═══ DIVIDER ═══ */
.divider{height:1px;background:linear-gradient(90deg,transparent,rgba(139,105,20,.15),rgba(13,125,108,.1),transparent);margin:0 36px}

/* ═══ PRINT BTN ═══ */
.print-btn{position:fixed;bottom:24px;right:24px;padding:14px 28px;background:linear-gradient(135deg,var(--gold),var(--gold-d));color:var(--dark);font-size:14px;font-weight:700;border:none;border-radius:12px;cursor:pointer;z-index:9999;box-shadow:0 4px 24px rgba(139,105,20,.4);transition:transform .2s}
.print-btn:hover{transform:scale(1.05)}
</style>
</head>
