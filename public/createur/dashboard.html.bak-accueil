// ═══════════════════════════════════
// STATUS HELPERS
// ═══════════════════════════════════
function statutProjetLabel(s) {
  const map = {
    prospect: '<span class="badge badge-purple">Prospect</span>',
    devis_envoye: '<span class="badge badge-warn">Devis envoye</span>',
    en_cours: '<span class="badge badge-accent">En cours</span>',
    livre: '<span class="badge badge-ok">Livre</span>',
    facture: '<span class="badge badge-blue">Facture</span>'
  };
  return map[s] || s;
}

function statutDocLabel(s) {
  const map = {
    brouillon: '<span class="badge" style="background:rgba(148,163,184,0.15);color:var(--muted);">Brouillon</span>',
    envoye: '<span class="badge badge-warn">Envoye</span>',
    accepte: '<span class="badge badge-ok">Accepte</span>',
    refuse: '<span class="badge badge-crit">Refuse</span>',
    paye: '<span class="badge badge-blue">Paye</span>'
  };
  return map[s] || s;
}

function typeDocLabel(t) {
  return t === 'facture' ? '<span class="badge badge-blue">Facture</span>' : '<span class="badge badge-accent">Devis</span>';
}

// ═══════════════════════════════════
// RENDER: DASHBOARD
// ═══════════════════════════════════
function renderDashboard() {
  const enCours = DEMO_PROJETS.filter(p => p.statut === 'en_cours').length;
  const devisAttente = DEMO_DOCUMENTS.filter(d => d.type === 'devis' && d.statut === 'envoye').length;
  const facturesImpayees = DEMO_DOCUMENTS.filter(d => d.type === 'facture' && (d.statut === 'envoye')).length;
  const caMois = DEMO_DOCUMENTS.filter(d => d.type === 'facture' && d.statut === 'paye' && d.date.startsWith('2026-04')).reduce((s, d) => s + d.montant, 0);

  document.getElementById('kpi-projets').textContent = enCours;
  document.getElementById('kpi-ca').textContent = fmtEur(caMois);
  document.getElementById('kpi-devis').textContent = devisAttente;
  document.getElementById('kpi-impayes').textContent = facturesImpayees;

  // Pipeline summary
  const statuts = ['prospect','devis_envoye','en_cours','livre','facture'];
  const statutNames = { prospect:'Prospect', devis_envoye:'Devis envoye', en_cours:'En cours', livre:'Livre', facture:'Facture' };
  const statutColors = { prospect:'var(--purple)', devis_envoye:'var(--amber)', en_cours:'var(--accent)', livre:'var(--green)', facture:'var(--blue)' };
  let pipelineHtml = '';
  let totalPipeline = 0;
  statuts.forEach(s => {
    const count = DEMO_PROJETS.filter(p => p.statut === s).length;
    const montant = DEMO_PROJETS.filter(p => p.statut === s).reduce((sum, p) => sum + p.montant, 0);
    totalPipeline += count;
    pipelineHtml += `<div class="compta-line">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="width:10px;height:10px;border-radius:50%;background:${statutColors[s]};display:inline-block;"></span>
        <span style="font-weight:500;">${statutNames[s]}</span>
        <span style="font-size:11px;color:var(--muted);">(${count})</span>
      </div>
      <span style="font-family:var(--mono);color:${statutColors[s]};">${fmtEur(montant)}</span>
    </div>`;
  });
  document.getElementById('pipeline-summary').innerHTML = pipelineHtml;
  document.getElementById('pipeline-count').textContent = totalPipeline + ' projets';

  // Objectif mensuel
  const objectif = 8000;
  const caTotal = DEMO_DOCUMENTS.filter(d => d.type === 'facture' && d.statut === 'paye').reduce((s, d) => s + d.montant, 0);
  const pct = Math.min(100, Math.round((caTotal / objectif) * 100));
  document.getElementById('objectif-pct').textContent = pct + '%';
  document.getElementById('objectif-fill').style.width = pct + '%';
  document.getElementById('objectif-ca').textContent = fmtEur(caTotal);
  document.getElementById('objectif-target').textContent = fmtEur(objectif);

  // Tresorerie
  const encaisse = DEMO_DOCUMENTS.filter(d => d.statut === 'paye').reduce((s, d) => s + d.montant, 0);
  const attente = DEMO_DOCUMENTS.filter(d => d.statut === 'envoye' && d.type === 'facture').reduce((s, d) => s + d.montant, 0);
  document.getElementById('treso-encaisse').textContent = fmtEur(encaisse);
  document.getElementById('treso-attente').textContent = fmtEur(attente);
  document.getElementById('treso-charges').textContent = fmtEur(850);
}

// ═══════════════════════════════════
// RENDER: PROJETS
// ═══════════════════════════════════
function renderProjets() {
  const tbody = document.getElementById('projets-body');
  const search = (document.getElementById('search-projets')?.value || '').toLowerCase();
  const statutFilter = document.getElementById('filter-statut-projet')?.value || '';

  let filtered = DEMO_PROJETS.filter(p => {
    if (search && !(p.nom + ' ' + p.client).toLowerCase().includes(search)) return false;
    if (statutFilter && p.statut !== statutFilter) return false;
    return true;
  });

  document.getElementById('projets-count').textContent = filtered.length + ' projet' + (filtered.length > 1 ? 's' : '');

  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--muted);">Aucun projet trouve</td></tr>';
    return;
  }

  tbody.innerHTML = filtered.map(p => {
    const barColor = p.progression >= 80 ? 'var(--green)' : p.progression >= 40 ? 'var(--accent)' : 'var(--amber)';
    return `<tr>
      <td><div style="font-weight:500;">${esc(p.nom)}</div><div style="font-size:11px;color:var(--muted);">${esc(p.notes)}</div></td>
      <td>${esc(p.client)}</td>
      <td>${statutProjetLabel(p.statut)}</td>
      <td style="font-family:var(--mono);font-weight:500;">${fmtEur(p.montant)}</td>
      <td style="font-size:12px;">${p.deadline}</td>
      <td>
        <div style="display:flex;align-items:center;gap:8px;">
          <div class="progress-bar" style="max-width:80px;"><div class="progress-fill" style="width:${p.progression}%;background:${barColor};"></div></div>
          <span style="font-family:var(--mono);font-size:12px;color:var(--muted);">${p.progression}%</span>
        </div>
      </td>
      <td>
        <div class="action-btns">
          <button class="icon-btn cmd" title="Voir le projet" aria-label="Voir le projet" onclick="showToast('Detail projet -- a venir')">&#x1F4C4;</button>
          <button class="icon-btn" title="Modifier" aria-label="Modifier" onclick="showToast('Modification -- a venir')">&#x270F;</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

function filterProjets() { renderProjets(); }

// ═══════════════════════════════════
// RENDER: CLIENTS
// ═══════════════════════════════════
function renderClients() {
  const tbody = document.getElementById('clients-body');
  const search = (document.getElementById('search-clients')?.value || '').toLowerCase();

  let filtered = DEMO_CLIENTS.filter(c => {
    if (search && !(c.nom + ' ' + c.email).toLowerCase().includes(search)) return false;
    return true;
  });

  document.getElementById('clients-count').textContent = filtered.length + ' client' + (filtered.length > 1 ? 's' : '');

  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--muted);">Aucun client trouve</td></tr>';
    return;
  }

  tbody.innerHTML = filtered.map(c => {
    return `<tr>
      <td style="font-weight:500;">${esc(c.nom)}</td>
      <td style="font-size:12px;">${esc(c.email)}</td>
      <td style="font-size:12px;">${esc(c.tel)}</td>
      <td style="font-family:var(--mono);text-align:center;">${c.nb_projets}</td>
      <td style="font-family:var(--mono);font-weight:500;">${fmtEur(c.ca_total)}</td>
      <td style="font-size:12px;">${c.dernier_contact}</td>
      <td>
        <div class="action-btns">
          <button class="icon-btn cmd" title="Voir le client" aria-label="Voir le client" onclick="showToast('Fiche client -- a venir')">&#x1F4C4;</button>
          <button class="icon-btn" title="Notes" aria-label="Notes" onclick="showToast('${esc(c.notes)}')">&#x1F4DD;</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

function filterClients() { renderClients(); }

// ═══════════════════════════════════
// RENDER: DEVIS & FACTURES
// ═══════════════════════════════════
function renderDevis() {
  const tbody = document.getElementById('devis-body');
  const search = (document.getElementById('search-devis')?.value || '').toLowerCase();
  const typeFilter = document.getElementById('filter-type-doc')?.value || '';
  const statutFilter = document.getElementById('filter-statut-doc')?.value || '';

  let filtered = DEMO_DOCUMENTS.filter(d => {
    if (search && !(d.numero + ' ' + d.client + ' ' + d.objet).toLowerCase().includes(search)) return false;
    if (typeFilter && d.type !== typeFilter) return false;
    if (statutFilter && d.statut !== statutFilter) return false;
    return true;
  });

  document.getElementById('devis-count').textContent = filtered.length + ' document' + (filtered.length > 1 ? 's' : '');

  // KPIs
  const devisEmis = DEMO_DOCUMENTS.filter(d => d.type === 'devis').length;
  const devisAcceptes = DEMO_DOCUMENTS.filter(d => d.type === 'devis' && d.statut === 'accepte').length;
  const taux = devisEmis > 0 ? Math.round((devisAcceptes / devisEmis) * 100) : 0;
  const facturesEmises = DEMO_DOCUMENTS.filter(d => d.type === 'facture').length;
  const impayesMontant = DEMO_DOCUMENTS.filter(d => d.type === 'facture' && d.statut === 'envoye').reduce((s, d) => s + d.montant, 0);

  document.getElementById('df-devis').textContent = devisEmis;
  document.getElementById('df-taux').textContent = taux + '%';
  document.getElementById('df-factures').textContent = facturesEmises;
  document.getElementById('df-impayes').textContent = fmtEur(impayesMontant);

  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--muted);">Aucun document trouve</td></tr>';
    return;
  }

  tbody.innerHTML = filtered.map(d => {
    return `<tr>
      <td style="font-family:var(--mono);font-size:12px;font-weight:500;">${esc(d.numero)}</td>
      <td>${typeDocLabel(d.type)}</td>
      <td style="font-weight:500;">${esc(d.client)}</td>
      <td style="font-size:12px;">${esc(d.objet)}</td>
      <td style="font-family:var(--mono);font-weight:500;">${fmtEur(d.montant)}</td>
      <td style="font-size:12px;">${d.date}</td>
      <td>${statutDocLabel(d.statut)}</td>
      <td>
        <div class="action-btns">
          <button class="icon-btn cmd" title="Telecharger PDF" aria-label="Telecharger PDF" onclick="showToast('Export PDF -- a venir')">&#x1F4E5;</button>
          <button class="icon-btn" title="Envoyer par email" aria-label="Envoyer par email" onclick="showToast('Envoi email -- a venir')">&#x2709;</button>
          ${d.type === 'devis' && d.statut === 'accepte' ? '<button class="icon-btn cmd" title="Convertir en facture" aria-label="Convertir en facture" onclick="showToast(\'Conversion devis en facture -- a venir\')">&#x1F4B3;</button>' : ''}
        </div>
      </td>
    </tr>`;
  }).join('');
}

function filterDevis() { renderDevis(); }

// ═══════════════════════════════════
// RENDER: PLANNING
// ═══════════════════════════════════
let planningRendered = false;
let planningWeekOffset = 0;

function renderPlanning() {
  planningRendered = true;
  const container = document.getElementById('planning-grid');
  const today = new Date();
  const start = new Date(today);
  start.setDate(start.getDate() - start.getDay() + 1 + planningWeekOffset * 7);

  const jours = ['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];

  let html = '';
  jours.forEach((jour, i) => {
    const d = new Date(start);
    d.setDate(d.getDate() + i);
    const dateStr = d.toLocaleDateString('fr-FR', { day:'numeric', month:'short' });
    const isToday = d.toDateString() === today.toDateString();

    const events = DEMO_PLANNING.filter(e => e.jour === i);
    let eventsHtml = '';
    if (events.length === 0) {
      eventsHtml = '<div style="font-size:11px;color:var(--muted);padding:8px;">Aucun evenement</div>';
    } else {
      events.forEach(e => {
        const heureStr = e.heure ? e.heure + ' -- ' : '';
        eventsHtml += `<div class="planning-event ${e.type}">
          <div style="font-weight:500;">${heureStr}${esc(e.label)}</div>
        </div>`;
      });
    }

    html += `<div class="planning-day" style="${isToday ? 'border-color:var(--accent);' : ''}">
      <div class="planning-day-title" style="${isToday ? 'color:var(--accent);' : 'color:var(--muted);'}">${jour} ${dateStr}</div>
      ${eventsHtml}
    </div>`;
  });

  container.innerHTML = html;
}

function planningPrev() { planningWeekOffset--; renderPlanning(); }
function planningNext() { planningWeekOffset++; renderPlanning(); }
function planningToday() { planningWeekOffset = 0; renderPlanning(); }

// ═══════════════════════════════════
// RENDER: PORTFOLIO
// ═══════════════════════════════════
function renderPortfolio() {
  const container = document.getElementById('portfolio-grid');
  if (DEMO_PORTFOLIO.length === 0) {
    container.innerHTML = '<div class="empty"><div class="empty-icon">&#x1F3A8;</div><div class="empty-title">Aucun projet en portfolio</div><div class="empty-sub">Ajoutez vos realisations pour les partager avec vos prospects.</div></div>';
    return;
  }
  container.innerHTML = DEMO_PORTFOLIO.map(p => {
    const tagsHtml = p.tags.map(t => `<span class="badge badge-accent">${esc(t)}</span>`).join('');
    const testimonialHtml = p.temoignage ? `<div class="portfolio-testimonial">"${esc(p.temoignage)}"</div>` : '';
    return `<div class="portfolio-item">
      <div class="portfolio-visual">${p.visual}</div>
      <div class="portfolio-body">
        <div class="portfolio-title">${esc(p.nom)}</div>
        <div style="font-size:11px;color:var(--accent);margin-bottom:6px;">${esc(p.client)}</div>
        <div class="portfolio-desc">${esc(p.desc)}</div>
        <div class="portfolio-tags">${tagsHtml}</div>
        ${testimonialHtml}
      </div>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════
// RENDER: COMPTABILITE
// ═══════════════════════════════════
function renderCompta() {
  const ca = 5900; // Q2 so far
  const charges = 850;
  const urssaf = Math.round(ca * 0.22);
  const net = ca - charges - urssaf;

  document.getElementById('compta-ca').textContent = fmtEur(ca);
  document.getElementById('compta-charges').textContent = fmtEur(charges);
  document.getElementById('compta-urssaf').textContent = fmtEur(urssaf);
  document.getElementById('compta-net').textContent = fmtEur(net);

  // Recettes par client
  const recettes = [
    { client:'Restaurant Le Jardin', montant:2800 },
    { client:'EcoBottle SAS', montant:1500 },
    { client:'Boulangerie Moreau', montant:1600 },
  ];
  document.getElementById('compta-recettes-detail').innerHTML = recettes.map(r =>
    `<div class="compta-line"><span>${esc(r.client)}</span><span style="font-family:var(--mono);color:var(--green);">${fmtEur(r.montant)}</span></div>`
  ).join('');

  // Charges
  const chargesDetail = [
    { poste:'Adobe Creative Cloud', montant:59.99 },
    { poste:'Figma Pro', montant:15 },
    { poste:'Domaines + Hebergement', montant:45 },
    { poste:'Abonnement JADOMI', montant:29.90 },
    { poste:'Telephone professionnel', montant:25 },
    { poste:'Banque pro', montant:9.90 },
    { poste:'Assurance RC Pro', montant:35 },
    { poste:'Coworking (10 jours)', montant:150 },
    { poste:'Divers (fournitures)', montant:30 },
  ];
  document.getElementById('compta-charges-detail').innerHTML = chargesDetail.map(c =>
    `<div class="compta-line"><span>${esc(c.poste)}</span><span style="font-family:var(--mono);color:var(--red);">-${fmtEur(c.montant)}</span></div>`
  ).join('');

  // Declaration
  document.getElementById('compta-declarable').textContent = fmtEur(ca);
  const caAnnuel = 18200; // projection
  document.getElementById('compta-tva-status').textContent = caAnnuel < 36800
    ? 'Statut TVA : Franchise en base (pas de TVA a facturer)'
    : 'Statut TVA : Seuil depasse, assujettissement TVA';
}

// ═══════════════════════════════════
// ADD ACTIONS
// ═══════════════════════════════════
function ajouterProjet() {
  const nom = document.getElementById('proj-nom').value.trim();
  if (!nom) { showToast('Veuillez renseigner le nom du projet'); return; }
  const newP = {
    id: DEMO_PROJETS.length + 1,
    nom: nom,
    client: document.getElementById('proj-client').value.trim() || 'Client inconnu',
    statut: document.getElementById('proj-statut').value,
    montant: parseFloat(document.getElementById('proj-montant').value) || 0,
    deadline: document.getElementById('proj-deadline').value || '--',
    progression: 0,
    notes: document.getElementById('proj-notes').value.trim()
  };
  DEMO_PROJETS.unshift(newP);
  fermerModal('modal-projet');
  renderProjets();
  showToast('Projet ajoute avec succes');
}

function ajouterClient() {
  const nom = document.getElementById('cli-nom').value.trim();
  if (!nom) { showToast('Veuillez renseigner le nom du client'); return; }
  const newC = {
    id: DEMO_CLIENTS.length + 1,
    nom: nom,
    email: document.getElementById('cli-email').value.trim(),
    tel: document.getElementById('cli-tel').value.trim(),
    nb_projets: 0,
    ca_total: 0,
    dernier_contact: new Date().toISOString().slice(0, 10),
    notes: document.getElementById('cli-notes').value.trim()
  };
  DEMO_CLIENTS.unshift(newC);
  fermerModal('modal-client');
  renderClients();
  showToast('Client ajoute avec succes');
}

function ajouterDevis() {
  const client = document.getElementById('dev-client').value.trim();
  if (!client) { showToast('Veuillez renseigner le client'); return; }
  const type = document.getElementById('dev-type').value;
  const prefix = type === 'facture' ? 'FAC' : 'DEV';
  const num = DEMO_DOCUMENTS.filter(d => d.type === type).length + 1;
  const newD = {
    id: DEMO_DOCUMENTS.length + 1,
    numero: `${prefix}-2026-${String(num).padStart(3, '0')}`,
    type: type,
    client: client,
    objet: document.getElementById('dev-objet').value.trim() || 'Sans objet',
    montant: parseFloat(document.getElementById('dev-montant').value) || 0,
    date: document.getElementById('dev-date').value || new Date().toISOString().slice(0, 10),
    statut: 'brouillon'
  };
  DEMO_DOCUMENTS.unshift(newD);
  fermerModal('modal-devis');
  renderDevis();
  showToast(type === 'facture' ? 'Facture creee avec succes' : 'Devis cree avec succes');
}

// ═══════════════════════════════════
// INIT
// ═══════════════════════════════════
document.addEventListener('DOMContentLoaded', async function() {
  const session = await checkAuth();
  renderDashboard();
  renderProjets();
  renderClients();
  renderDevis();
  renderPortfolio();
  renderCompta();
});
</script>
</body>
</html>