<script>
// ═══════════════════════════════════
// SUPABASE INIT
// ═══════════════════════════════════
let db = null;
try {
  const SUPABASE_URL = 'https://vsbomwjzehnfinfjvhqp.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_RcfR0_sq5Z-oWK97ij27Yw_tGfur7UF';
  const { createClient } = supabase;
  db = createClient(SUPABASE_URL, SUPABASE_KEY);
} catch(e) { console.warn('Supabase init failed:', e); }

// ═══════════════════════════════════
// AUTH CHECK
// ═══════════════════════════════════
async function checkAuth() {
  try {
    if (!db) return null;
    const { data: { session } } = await db.auth.getSession();
    if (!session) { location.href = '/login.html'; return null; }
    return session;
  } catch(e) {
    console.warn('Auth check failed:', e);
    return null;
  }
}

// ═══════════════════════════════════
// PAGE NAVIGATION
// ═══════════════════════════════════
const pageTitles = {
  dashboard: 'Tableau de bord',
  projets: 'Mes projets',
  clients: 'Clients',
  devis: 'Devis & Factures',
  planning: 'Planning',
  portfolio: 'Portfolio',
  compta: 'Comptabilite',
  outils: 'Templates & Outils'
};

const pageActions = {
  dashboard: '',
  projets: '<button class="btn btn-accent" onclick="ouvrirModalProjet()">+ Nouveau projet</button>',
  clients: '<button class="btn btn-accent" onclick="ouvrirModalClient()">+ Nouveau client</button>',
  devis: '<button class="btn btn-accent" onclick="ouvrirModalDevis()">+ Nouveau devis</button>',
  planning: '',
  portfolio: '<button class="btn btn-accent" onclick="showToast(\'Ajout portfolio -- a venir\')">+ Ajouter un projet</button>',
  compta: '',
  outils: ''
};

function showPage(id, el) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item,.mnav-item').forEach(n => n.classList.remove('active'));
  const page = document.getElementById('page-' + id);
  if (page) page.classList.add('active');
  document.getElementById('page-title').textContent = pageTitles[id] || id;
  document.getElementById('topbar-actions').innerHTML = pageActions[id] || '';
  if (el) { el.classList.add('active'); openParentNavGroup(el); }
  // Lazy render
  if (id === 'dashboard') renderDashboard();
  if (id === 'projets') renderProjets();
  if (id === 'clients') renderClients();
  if (id === 'devis') renderDevis();
  if (id === 'planning' && !planningRendered) renderPlanning();
  if (id === 'portfolio') renderPortfolio();
  if (id === 'compta') renderCompta();
}

// ═══════════════════════════════════
// NAV GROUP ACCORDION
// ═══════════════════════════════════
function toggleNavGroup(title) {
  const items = title.nextElementSibling;
  const arrow = title.querySelector('.nav-group-arrow');
  if (!items) return;
  const open = items.style.display !== 'none';
  items.style.display = open ? 'none' : 'block';
  if (arrow) arrow.classList.toggle('open', !open);
}

function openParentNavGroup(el) {
  const group = el.closest('.nav-group-items');
  if (group && group.style.display === 'none') {
    group.style.display = 'block';
    const arrow = group.previousElementSibling?.querySelector('.nav-group-arrow');
    if (arrow) arrow.classList.add('open');
  }
}

// ═══════════════════════════════════
// SIDEBAR TOGGLE (MOBILE)
// ═══════════════════════════════════
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
}
(function(){
  const mq = window.matchMedia('(max-width:768px)');
  function check(e) { document.getElementById('burger-btn').style.display = e.matches ? 'inline-flex' : 'none'; }
  mq.addEventListener('change', check);
  check(mq);
})();

// ═══════════════════════════════════
// TOAST
// ═══════════════════════════════════
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

// ═══════════════════════════════════
// MODAL HELPERS
// ═══════════════════════════════════
function ouvrirModalProjet() { document.getElementById('modal-projet').classList.add('open'); }
function ouvrirModalClient() { document.getElementById('modal-client').classList.add('open'); }
function ouvrirModalDevis() { document.getElementById('modal-devis').classList.add('open'); }
function fermerModal(id) { document.getElementById(id).classList.remove('open'); }

document.querySelectorAll('.modal-overlay').forEach(ov => {
  ov.addEventListener('click', function(e) { if (e.target === this) this.classList.remove('open'); });
});

// ═══════════════════════════════════
// UTILITIES
// ═══════════════════════════════════
function esc(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
function fmtEur(n) { return new Intl.NumberFormat('fr-FR', { style:'currency', currency:'EUR' }).format(n); }

