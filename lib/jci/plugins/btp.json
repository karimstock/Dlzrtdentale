{
  "name": "btp",
  "label": "Entreprise BTP / Artisan",
  "version": "1.0",

  "node_types": [
    "client",
    "chantier",
    "devis",
    "facture",
    "ouvrier",
    "sous_traitant",
    "materiau",
    "fournisseur",
    "machine",
    "planning",
    "sinistre"
  ],

  "edge_types": [
    { "type": "commande", "from": "client", "to": "chantier" },
    { "type": "travaille", "from": "ouvrier", "to": "chantier" },
    { "type": "sous_traite", "from": "sous_traitant", "to": "chantier" },
    { "type": "fournit", "from": "fournisseur", "to": "materiau" },
    { "type": "utilise", "from": "chantier", "to": "materiau" },
    { "type": "utilise_machine", "from": "chantier", "to": "machine" },
    { "type": "chiffre", "from": "devis", "to": "chantier" },
    { "type": "facture", "from": "facture", "to": "chantier" },
    { "type": "planifie", "from": "planning", "to": "chantier" },
    { "type": "concerne", "from": "sinistre", "to": "chantier" }
  ],

  "agents": [
    {
      "role": "project_planner",
      "prompt": "Planifie les chantiers, gere les delais, detecte les retards potentiels. Optimise l'enchainement des interventions."
    },
    {
      "role": "cost_controller",
      "prompt": "Compare devis vs realise, detecte les depassements, analyse la rentabilite par chantier."
    },
    {
      "role": "resource_manager",
      "prompt": "Gere l'affectation des ouvriers et machines, detecte les sous-effectifs, les periodes creuses."
    },
    {
      "role": "compliance_checker",
      "prompt": "Verifie la conformite reglementaire : assurances, qualifications, normes, securite chantier."
    }
  ],

  "contradictory_roles": [
    {
      "role": "optimist",
      "prompt": "Defends pourquoi ce chantier ou cette decision va bien se passer."
    },
    {
      "role": "pessimist",
      "prompt": "Identifie les risques : meteo, retard fournisseur, accident, litige client."
    },
    {
      "role": "risk_assessor",
      "prompt": "Evalue le risque financier et juridique. Peut bloquer un chantier sous-estime ou non conforme."
    }
  ],

  "authority": {
    "risk_assessor": "veto",
    "compliance_checker": "veto",
    "project_planner": "execute",
    "cost_controller": "propose",
    "resource_manager": "execute"
  },

  "trust": {
    "threshold": 0.45
  },

  "debate": {
    "maxRounds": 3,
    "minAgents": 3
  }
}
